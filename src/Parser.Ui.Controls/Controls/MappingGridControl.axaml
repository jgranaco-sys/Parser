<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="Parser.Ui.Controls.Controls.MappingGridControl">
  <DataGrid Name="Grid"
            AutoGenerateColumns="False"
            IsReadOnly="False"
            GridLinesVisibility="All"
            ItemsSource="{Binding $parent[UserControl].ItemsSource}">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Incoming Field" Binding="{Binding IncomingField}" Width="*" />
      <DataGridTextColumn Header="SCADA Variable" Binding="{Binding ScadaVariable}" Width="*" />
      <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="120" />
      <DataGridTextColumn Header="Transform" Binding="{Binding Transform}" Width="*" />
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
