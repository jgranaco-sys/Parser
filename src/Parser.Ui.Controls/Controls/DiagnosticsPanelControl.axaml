<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="Parser.Ui.Controls.Controls.DiagnosticsPanelControl">
  <DataGrid Name="Grid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="All"
            ItemsSource="{Binding $parent[UserControl].ItemsSource}">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="180" />
      <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100" />
      <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
      <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
