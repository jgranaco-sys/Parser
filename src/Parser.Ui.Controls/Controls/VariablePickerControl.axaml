<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="Parser.Ui.Controls.Controls.VariablePickerControl">
  <ComboBox Name="Picker"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding $parent[UserControl].ItemsSource}"
            SelectedItem="{Binding $parent[UserControl].SelectedItem, Mode=TwoWay}"
            PlaceholderText="Select a variable" />
</UserControl>
