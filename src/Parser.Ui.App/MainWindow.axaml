<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Parser.Ui.Core.ViewModels;assembly=Parser.Ui.Core"
        xmlns:views="clr-namespace:Parser.Ui.App.Views"
        x:Class="Parser.Ui.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Parser - Payload Transformation Studio"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="vm:InputConfigViewModel">
            <views:InputConfigView />
        </DataTemplate>
        <DataTemplate DataType="vm:MappingEditorViewModel">
            <views:MappingEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:TransformationsViewModel">
            <views:TransformationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ValidationViewModel">
            <views:ValidationView />
        </DataTemplate>
        <DataTemplate DataType="vm:TemplateEditorViewModel">
            <views:TemplateEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:OutputConfigViewModel">
            <views:OutputConfigView />
        </DataTemplate>
        <DataTemplate DataType="vm:TestingViewModel">
            <views:TestingView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesViewModel">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:PluginManagerViewModel">
            <views:PluginManagerView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel>
        <!-- Top menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Profile" />
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Theme" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Plugin Manager" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>

        <!-- Header: breadcrumb + profile selector -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8">
            <TextBlock Grid.Column="0" Text="{Binding Breadcrumb}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberBinding="{Binding Name}"
                          Width="220" />
                <Button Content="Activate" Command="{Binding SwitchProfileCommand}" />
            </StackPanel>
        </Grid>

        <!-- Bottom status bar -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="12,4">
            <TextBlock Grid.Column="0" Text="{Binding HasUnsavedChanges, StringFormat='Unsaved changes: {0}'}" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentTheme, StringFormat='Theme: {0}'}" />
        </Grid>

        <!-- Body: left navigation + content -->
        <Grid ColumnDefinitions="240,*">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     Margin="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Margin="4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <Border Grid.Column="1" Padding="16">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
