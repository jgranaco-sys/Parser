<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Parser.Ui.Core.ViewModels;assembly=Parser.Ui.Core"
             x:Class="Parser.Ui.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Profiles" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBox Watermark="New profile name" Text="{Binding NewProfileName}" Width="200" />
            <Button Content="Create" Command="{Binding CreateCommand}" />
            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <Button Content="Set Active" Command="{Binding SetActiveCommand}" />
            <Button Content="Save" Command="{Binding UpdateCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="All"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Input Format" Binding="{Binding InputFormat}" Width="120" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
