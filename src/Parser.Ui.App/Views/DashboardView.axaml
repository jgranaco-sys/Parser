<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Parser.Ui.Core.ViewModels;assembly=Parser.Ui.Core"
             x:Class="Parser.Ui.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" />
        <UniformGrid Columns="3" Rows="2">
            <Border Classes="card" Margin="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Status" Opacity="0.7" />
                    <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Active Profile" Opacity="0.7" />
                    <TextBlock Text="{Binding ActiveProfileName}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Mapped Variables" Opacity="0.7" />
                    <TextBlock Text="{Binding MappedVariableCount}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Errors" Opacity="0.7" />
                    <TextBlock Text="{Binding ErrorCount}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Messages / sec" Opacity="0.7" />
                    <TextBlock Text="{Binding MessagesPerSecond}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
